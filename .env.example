# ============================================================
# 环境变量 (请勿提交到 Git)
# 复制此文件为 .env 并填入真实值
# ============================================================

# VLM API 密钥 (通义千问 / Qwen-VL)
DASHSCOPE_API_KEY=your_api_key_here

# 可选：其他 VLM 提供商
GEMINI_API_KEY=

# 数据库加密密钥 (生产环境必须设置)
DB_ENCRYPTION_KEY=your_encryption_key_here

# 应用账户密码 (不设置则自动生成随机密码)
APP_DEFAULT_PASSWORD=your_password_here

# 各角色账户独立密码 (可选，回退到 APP_DEFAULT_PASSWORD)
ACCOUNT_PW_admin=
ACCOUNT_PW_inspector=
ACCOUNT_PW_supervisor=
ACCOUNT_PW_ai_engineer=
ACCOUNT_PW_process_engineer=

# Token HMAC 签名密钥 (不设置则自动生成)
TOKEN_SECRET=

# CORS 允许的源 (逗号分隔，默认仅允许本地开发)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 运行环境 (development/production)
ENV=development

# Gradio 认证 (可选，格式: user:pass)
GRADIO_AUTH=
