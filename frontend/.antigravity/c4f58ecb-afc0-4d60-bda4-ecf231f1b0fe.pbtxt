        }
        lines {
          text: "  const [selectedSample, setSelectedSample] = useState<DefectSample>(SAMPLE_PRESETS[1]); // scratch by default"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [customImageBase64, setCustomImageBase64] = useState<string | null>(null);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
