        }
        lines {
          text: "    chineseName: \'\351\253\230\346\270\251\347\203\255\350\277\236\350\275\247\351\223\201\347\264\240\344\275\223\346\256\213\347\225\231\346\260\247\345\214\226\347\232\256\',"
