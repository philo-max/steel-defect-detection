          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      setSelectedDefectId(isSelected ? null : defect.id);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onMouseEnter={() => setHoveredDefectId(defect.id)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onMouseLeave={() => setHoveredDefectId(null)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
