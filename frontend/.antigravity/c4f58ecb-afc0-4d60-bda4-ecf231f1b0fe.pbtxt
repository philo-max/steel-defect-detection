          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Viewer and Scan State"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [viewMode, setViewMode] = useState<\'standard\' | \'infrared\' | \'edge\' | \'contrast\'>(\'standard\');"
