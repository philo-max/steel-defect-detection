    replacement_chunks {
      target_content: "              <Info className=\"h-4 w-4 text-blue-400\" />\n              <h2 className=\"text-xs font-bold uppercase tracking-widest text-white\">\346\231\266\345\214\205\347\274\272\351\231\267\345\206\266\351\207\221\346\210\220\345\233\240\346\234\272\347\220\206</h2>\n            </div>\n\n            {activeResult ? (\n              <div className=\"space-y-3 prose text-xs leading-relaxed text-gray-300\">\n                <div className=\"p-3.5 bg-[#151a21] border border-[#212c3d] rounded-xl relative overflow-hidden\">\n                  <div className=\"absolute top-0 right-0 p-1.5 bg-blue-900/10 text-blue-400 rounded-bl text-[8px] uppercase font-mono tracking-widest font-bold\">\n                    Micro-Mechanics\n                  </div>\n                  <p className=\"font-semibold text-gray-100 text-[11px] mb-2 font-mono flex items-center gap-1.5\">\n                    <span className=\"h-1.5 w-1.5 bg-blue-400 rounded-full\"></span>\n                    <span>\347\220\206\345\214\226\346\230\276\345\276\256\346\210\220\345\233\240\346\236\220\347\275\256:</span>\n                  </p>\n                  <p className=\"indent-5 leading-relaxed text-slate-300 text-justify\">\n                    {activeResult.chemicalExplanation}\n                  </p>\n                </div>\n\n                <div className=\"p-3.5 bg-cyan-950/15 border border-cyan-900/45 rounded-xl\">\n                  <p className=\"font-semibold text-cyan-400 text-[11px] mb-2 font-mono flex items-center gap-1.5\">\n                    <span className=\"h-1.5 w-1.5 bg-cyan-400 rounded-full\"></span>\n                    <span>\345\206\215\345\212\240\345\267\245\345\244\204\347\275\256\344\270\216\346\216\222\344\272\247\346\214\207\344\273\244\345\273\272\350\256\256:</span>\n                  </p>\n                  <p className=\"leading-relaxed font-sans text-gray-200\">\n                    {activeResult.recommendedAction}\n                  </p>\n                </div>\n              </div>\n            ) : (\n              <p className=\"text-xs text-gray-500 text-justify leading-relaxed\">\n                \345\210\206\346\236\220\346\212\245\345\221\212\345\260\206\350\276\223\345\207\272\345\276\256\345\272\224\345\212\233\345\217\230\345\214\226\343\200\201\345\206\267\345\215\264\345\217\212\347\273\223\346\231\266\346\227\266\347\233\270\345\217\230\343\200\201\346\260\247\345\214\226\347\211\251\346\235\202\350\264\250\346\262\211\351\231\215\346\210\226\347\203\255\350\277\236\350\275\247\350\277\207\345\272\246\345\216\213\345\272\224\345\212\233\347\255\211\347\220\206\345\214\226\345\255\246\346\234\272\347\220\206\345\216\237\345\233\240\343\200\202\n              </p>\n            )}\n          </div>\n\n          {/* DETAILED DEFECT LIST / RETICLE POSITION REGIONS */}\n          <div className=\"pt-4 space-y-3 flex-1 flex flex-col\">\n            <div className=\"flex justify-between items-center text-white border-b border-[#1f2833]/60 pb-1.5\">\n              <div className=\"flex items-center gap-2\">\n                <FileSpreadsheet className=\"h-4 w-4 text-cyan-400\" />\n                <h2 className=\"text-xs font-bold uppercase tracking-widest text-white\">\345\276\256\347\273\206\345\214\272\345\237\237\347\227\205\347\201\266\346\211\253\346\217\217\350\257\246\345\215\225</h2>\n              </div>\n              {activeResult && activeResult.defects && activeResult.defects.length > 0 && (\n                <span className=\"font-mono text-[10px] px-1.5 py-0.5 rounded bg-gray-900 text-cyan-400 border border-gray-800\">\n                  {activeResult.defects.length} \344\270\252\347\233\256\346\240\207\n                </span>\n              )}\n            </div>\n\n            {activeResult && activeResult.defects && activeResult.defects.length > 0 ? (\n              <div className=\"space-y-2.5 max-h-[220px] overflow-y-auto pr-1\">\n                {activeResult.defects.map((defect) => {\n                  const isHovered = hoveredDefectId === defect.id;\n                  const isSelected = selectedDefectId === defect.id;\n                  \n                  return (\n                    <div\n                      key={defect.id}\n                      id={`defect_card_${defect.id}`}\n                      onMouseEnter={() => setHoveredDefectId(defect.id)}\n                      onMouseLeave={() => setHoveredDefectId(null)}\n                      onClick={() => setSelectedDefectId(isSelected ? null : defect.id)}\n                      className={`p-3 rounded-xl border text-xs cursor-pointer transition-all ${\n                        isSelected || isHovered\n                          ? \'bg-[#1a212b] border-blue-500 shadow\'\n                          : \'bg-[#151a21]/50 border-[#1f2833] hover:bg-[#1a212b]/40\'\n                      }`}\n                    >\n                      <div className=\"flex justify-between items-start mb-1.5\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className={`h-2 w-2 rounded-full ${\n                            defect.severity === \'High\' ? \'bg-red-500\' :\n                            defect.severity === \'Medium\' ? \'bg-amber-400\' : \'bg-blue-400\'\n                          }`}></span>\n                          <span className=\"font-bold text-gray-100\">{defect.typeName}</span>\n                        </div>\n                        <span className={`px-1.5 py-0.5 rounded-[4px] text-[9px] font-mono font-bold ${\n                          defect.severity === \'High\' \n                            ? \'bg-red-950 text-red-400 border border-red-920\' \n                            : defect.severity === \'Medium\'\n                            ? \'bg-amber-950 text-amber-400 border border-amber-920\'\n                            : \'bg-blue-950 text-blue-400 border border-blue-920\'\n                        }`}>\n                          {defect.severity === \'High\' ? \'\351\253\230\345\215\261\351\231\251\' : defect.severity === \'Medium\' ? \'\344\270\255\347\255\211\' : \'\344\275\216\345\215\261\345\256\263\'}\n                        </span>\n                      </div>\n                      \n                      <p className=\"text-[11px] text-gray-400 leading-relaxed font-sans mt-1\">\n                        {defect.description}\n                      </p>\n\n                      <div className=\"flex justify-between items-center text-[10px] text-gray-500 font-mono mt-2 pt-2 border-t border-[#1f2833]/50\">\n                        <span>CCD \345\235\220\346\240\207: [Y:{defect.bbox[0]}, X:{defect.bbox[1]}]</span>\n                        <div className=\"flex items-center gap-3\">\n                          <span className=\"text-emerald-500 font-bold\">\347\275\256\344\277\241\345\200\274 {(defect.confidence * 100).toFixed(0)}%</span>\n                          {/* Manual Audit Trigger button */}\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              handleOpenAuditModal(defect);\n                            }}\n                            className=\"text-blue-400 hover:text-blue-300 font-semibold underline underline-offset-2\"\n                            title=\"\344\277\256\346\255\243\347\274\272\351\231\267\345\261\236\346\200\247\345\210\206\347\261\273\344\270\216\345\215\261\351\231\251\347\255\211\347\272\247\"\n                          >\n                            \344\270\223\345\256\266\345\244\215\345\256\241\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            ) : activeResult ? (\n              <div className=\"py-8 text-center text-xs text-emerald-400 bg-emerald-950/10 border border-emerald-900 rounded-xl space-y-1\">\n                <ShieldCheck className=\"h-6 w-6 text-emerald-500 mx-auto mb-1 animate-pulse\" />\n                <p className=\"font-bold\">\346\235\220\350\264\250\346\243\200\351\252\214\345\220\210\346\240\274</p>\n                <p className=\"text-[10px] text-gray-400\">\346\235\277\351\235\242\344\270\212\350\241\250\351\235\242\347\262\276\345\276\256\346\211\253\346\217\217\344\273\252\345\206\205\346\234\252\346\216\242\346\237\245\345\210\260\345\217\257\350\247\201\347\274\272\351\231\267\343\200\202</p>\n              </div>\n            ) : (\n              <p className=\"text-xs text-gray-500 text-center py-6 border border-[#1f2833] border-dashed rounded-xl\">\n                \350\257\267\345\205\210\345\234\250\345\267\246\344\270\213\350\247\222\345\220\257\345\212\250\350\257\212\346\226\255\343\200\202\n              </p>\n            )}\n          </div>\n        </section>\n      </main>\n\n      {/* METALLURGY EXPERT AUDIT OVERRIDE MODAL - Human in the loop overrides */}\n      {auditingDefect && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm\">\n          <div className=\"bg-[#151a21] border border-[#2d3a4f] rounded-2xl w-full max-w-md p-6 relative shadow-2xl\">\n            <button\n              onClick={() => setAuditingDefect(null)}\n              className=\"absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-full hover:bg-white/5\"\n            >\n              <X className=\"h-5 w-5\" />\n            </button>\n\n            <div className=\"flex items-center gap-2 mb-4 text-white\">\n              <Settings className=\"h-5 w-5 text-blue-400\" />\n              <h3 className=\"text-sm font-bold uppercase tracking-wider\">\350\264\250\346\243\200\345\267\245\347\250\213\345\270\210\345\244\215\346\240\270\345\256\241\350\256\241\347\252\227</h3>\n            </div>\n\n            <p className=\"text-xs text-gray-400 mb-4 bg-gray-900/60 p-3 rounded-lg border border-gray-800\">\n              \347\274\272\351\231\267ID: <span className=\"font-mono text-gray-300\">{auditingDefect.id}</span>\n              <br />\n              \345\275\223\345\211\215AI\350\257\204\350\257\255: <span className=\"text-gray-300\">{auditingDefect.description}</span>\n            </p>\n\n            <div className=\"space-y-4\">\n              {/* Dropdown class taxonomy type selection */}\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-gray-300 block\">\347\274\272\351\231\267\351\207\215\345\275\222\347\261\273\345\210\206\347\261\273 (Type)</label>\n                <select\n                  value={auditClass}\n                  onChange={(e) => setAuditClass(e.target.value)}\n                  className=\"w-full text-xs font-semibold bg-[#0b0c10] border border-[#2d3a4f] rounded-lg px-3 py-2 text-white focus:outline-none focus:border-blue-500\"\n                >\n                  <option value=\"Scratches\">Scratches (\345\210\222\347\227\225\346\213\211\344\274\244)</option>\n                  <option value=\"Cracks\">Cracks (\350\276\271\347\274\230\346\222\225\350\243\202\350\243\202\347\272\271)</option>\n                  <option value=\"Pitting\">Pitting (\350\266\205\351\205\270\350\232\200\351\233\206\350\201\232\345\207\271\345\235\221)</option>\n                  <option value=\"Inclusions\">Inclusions (\344\277\235\346\212\244\346\270\243\351\222\242\345\206\205\351\235\236\351\207\221\345\261\236\346\235\202\350\264\250)</option>\n                  <option value=\"Scale\">Scale (\345\261\200\351\203\250\347\262\230\347\273\223\347\212\266\346\260\247\345\214\226\351\223\201\351\263\236\347\232\256)</option>\n                  <option value=\"Patches\">Patches (\346\260\264\346\262\271\344\271\263\345\214\226\346\270\205\346\264\227\346\270\215\346\226\221)</option>\n                  <option value=\"None\">None (\346\227\240\347\274\272\351\231\267\357\274\214\351\207\215\345\256\232\344\270\272\345\220\210\346\240\274\346\235\277\351\235\242)</option>\n                </select>\n              </div>\n\n              {/* Severity selection */}\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-gray-300 block\">\345\215\261\345\256\263\344\270\245\351\205\267\345\272\246 (Severity)</label>\n                <div className=\"grid grid-cols-3 gap-2 text-xs\">\n                  {([\'Low\', \'Medium\', \'High\'] as const).map((sev) => (\n                    <button\n                      key={sev}\n                      type=\"button\"\n                      onClick={() => setAuditSeverity(sev)}\n                      className={`py-1.5 px-2 rounded-lg font-bold border transition ${\n                        auditSeverity === sev\n                          ? sev === \'High\' ? \'bg-red-950/60 border-red-500 text-red-400\' : sev === \'Medium\' ? \'bg-amber-950/60 border-amber-500 text-amber-400\' : \'bg-blue-950/60 border-blue-500 text-blue-400\'\n                          : \'bg-[#0b0c10] border-[#2d3a4f] text-gray-400 hover:text-white\'\n                      }`}\n                    >\n                      {sev === \'High\' ? \'HIGH\345\215\261\351\231\251\' : sev === \'Medium\' ? \'MEDIUM\344\270\255\347\255\211\' : \'LOW\345\276\256\345\274\261\'}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Expert physical commentary */}\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-gray-300 block\">\345\267\245\347\250\213\345\270\210\347\220\206\345\214\226\345\256\241\350\256\241\345\244\207\346\263\250 (\345\277\205\345\241\253)</label>\n                <textarea\n                  rows={3}\n                  value={auditComment}\n                  onChange={(e) => setAuditComment(e.target.value)}\n                  placeholder=\"\350\257\267\350\276\223\345\205\245\344\272\272\345\267\245\345\210\206\346\236\220\345\244\207\346\263\250\343\200\202\344\276\213\345\246\202\357\274\232\350\276\212\347\211\207\345\261\200\351\203\250\347\262\230\347\240\202\345\257\274\350\207\264\346\213\211\344\274\270\346\273\221\347\227\225...\"\n                  className=\"w-full text-xs bg-[#0b0c10] border border-[#2d3a4f] rounded-lg p-2.5 text-white focus:outline-none focus:border-blue-500 placeholder-gray-600\"\n                />\n              </div>\n\n              <div className=\"flex gap-2.5 pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setAuditingDefect(null)}\n                  className=\"flex-1 py-2 bg-[#1f2833] hover:bg-[#2d3a4f] rounded-lg text-xs text-white font-semibold transition\"\n                >\n                  \345\217\226\346\266\210\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={submitManualAudit}\n                  className=\"flex-1 py-1 px-4 bg-blue-500 hover:bg-blue-600 rounded text-xs text-[#0b0c10] font-bold transition flex items-center justify-center gap-1.5\"\n                >\n                  <Check className=\"h-4 w-4\" />\n                  \346\240\270\346\237\245\347\255\276\345\217\221(Override)\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* HISTORICAL ARCHIVE PORTAL MODAL */}\n      {showHistoryModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/8 w-full h-full bg-black/75 backdrop-blur-sm\">\n          <div className=\"bg-[#151a21] border border-[#2d3a4f] rounded-2xl w-full max-w-2xl p-6 relative shadow-2xl flex flex-col max-h-[85vh]\">\n            <button\n              onClick={() => setShowHistoryModal(false)}\n              className=\"absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-full hover:bg-white/5 bg-gray-900/40\"\n            >\n              <X className=\"h-5 w-5\" />\n            </button>\n\n            <div className=\"flex items-center gap-2.5 mb-5 border-b border-[#2d3a4f]/50 pb-3\">\n              <History className=\"h-5 w-5 text-cyan-400\" />\n              <div>\n                <h3 className=\"text-sm font-bold uppercase tracking-wider text-white\">\350\275\247\346\235\220\347\274\272\351\231\267\345\205\211\345\255\246\345\216\206\345\217\262\346\216\242\346\237\245\346\227\245\345\277\227</h3>\n                <p className=\"text-[11px] text-gray-500\">\346\243\200\346\265\213\345\261\245\345\216\206\345\267\262\345\256\211\345\205\250\347\246\273\347\272\277\344\277\235\345\255\230\345\234\250\346\234\254\345\234\260\345\277\253\347\205\247\346\225\260\346\215\256\345\272\223\344\270\255</p>\n              </div>\n            </div>\n\n            <div className=\"flex-1 overflow-y-auto space-y-3 pr-1\">\n              {history.length > 0 ? (\n                history.map((rec) => {\n                  const hasDefects = rec.result.defects && rec.result.defects.length > 0;\n                  return (\n                    <div\n                      key={rec.id}\n                      onClick={() => handleRecallHistoryRecord(rec)}\n                      className=\"p-3.5 bg-[#0b0c10] border border-[#1f2833] hover:border-gray-500 rounded-xl cursor-pointer transition flex flex-col md:flex-row justify-between items-start md:items-center gap-3 relative group\"\n                    >\n                      <div className=\"space-y-1\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className={`text-[10px] font-mono px-1 rounded ${hasDefects ? \'bg-red-950 text-red-400 border border-red-900/40\' : \'bg-emerald-950 text-emerald-400 border border-emerald-900/40\'}`}>\n                            {rec.result.overallStatus === \'Pass\' ? \'\345\220\210\346\240\274\' : rec.result.overallStatus === \'Marginal\' ? \'\351\231\215\347\272\247\' : \'\344\270\215\345\220\210\346\240\274\'}\n                          </span>\n                          <h4 className=\"text-xs font-bold text-white tracking-wide\">{rec.imageName}</h4>\n                        </div>\n                        \n                        <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-gray-500 font-mono\">\n                          <span>\346\265\201\346\260\264\345\217\267: {rec.id}</span>\n                          <span>\346\227\266\351\227\264: {rec.timestamp}</span>\n                          {hasDefects && (\n                            <span className=\"text-amber-500 font-bold\">\346\243\200\346\265\213\347\274\272\351\231\267 {rec.result.defects.length} \345\244\204</span>\n                          )}\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center gap-3 shrink-0 self-end md:self-center\">\n                        <span className=\"text-xs text-gray-400 font-mono font-bold bg-gray-900 px-2 py-1 rounded border border-gray-800\">\n                          \346\214\207\346\225\260: {rec.result.severityIndex}\n                        </span>\n                        \n                        <button\n                          onClick={(e) => handleDeleteHistoryItem(rec.id, e)}\n                          className=\"p-1.5 bg-red-950/10 hover:bg-red-950/80 rounded border border-red-950 text-gray-400 hover:text-red-400 transition\"\n                          title=\"\345\210\240\351\231\244\346\255\244\345\255\230\346\241\243\"\n                        >\n                          <Trash2 className=\"h-4 w-4\" />\n                        </button>\n                      </div>\n                    </div>\n                  );\n                })\n              ) : (\n                <div className=\"py-12 text-center text-xs text-gray-500\">\n                  <Database className=\"h-8 w-8 text-gray-600 mx-auto mb-2\" />\n                  <span>\346\232\202\346\227\240\345\216\206\345\217\262\350\257\212\346\226\255\346\227\245\345\277\227\345\255\230\346\241\243</span>\n                </div>\n              )}\n            </div>\n\n            <div className=\"pt-4 border-t border-[#2d3a4f]/50 mt-4 flex justify-end\">\n              <button\n                onClick={() => setShowHistoryModal(false)}\n                className=\"py-1.5 px-4 bg-gray-800 hover:bg-gray-700 text-white rounded text-xs font-semibold transition\"\n              >\n                \345\205\263\351\227\255\350\247\206\347\252\227\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* FOOTER METADATA telemetries */}\n      <footer className=\"bg-[#07090c] border-t border-[#1f2833] py-2 px-6 flex justify-between items-center text-[10px] text-gray-500 font-mono mt-auto select-none\">\n        <span>\302\251 \351\222\242\351\223\201\347\274\272\351\231\267\350\257\212\346\226\255\346\216\247\345\210\266\345\217\260\347\263\273\347\273\237 \342\200\242 \345\233\275\344\272\247\345\214\226\351\253\230\347\262\276\345\272\246\345\267\245\344\270\232\347\224\237\344\272\247\347\272\277\347\273\210\347\253\257\350\256\276\345\244\207 V4.1</span>\n        <span>CCD: Active \342\200\242 Laser: {laserSpeed}00Hz \342\200\242 Contrast: {contrastThreshold}%</span>\n      </footer>"
      replacement_content: "              <Info className=\"h-4 w-4 text-blue-600\" />\n              <h2 className=\"text-xs font-bold uppercase tracking-wider text-slate-500\">\346\231\266\345\214\205\347\274\272\351\231\267\345\206\266\351\207\221\346\210\220\345\233\240\346\234\272\347\220\206</h2>\n            </div>\n\n            {activeResult ? (\n              <div className=\"space-y-3 text-xs leading-relaxed text-slate-600\">\n                <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl relative overflow-hidden\">\n                  <div className=\"absolute top-0 right-0 p-1 bg-slate-200 text-slate-600 rounded-bl text-[8px] uppercase font-mono tracking-widest font-bold\">\n                    Micro-Mechanics\n                  </div>\n                  <p className=\"font-semibold text-slate-700 text-[11px] mb-1.5 font-mono flex items-center gap-1.5\">\n                    <span className=\"h-1.5 w-1.5 bg-blue-500 rounded-full\"></span>\n                    <span>\347\220\206\345\214\226\346\230\276\345\276\256\346\210\220\345\233\240\346\236\220\347\275\256:</span>\n                  </p>\n                  <p className=\"indent-5 leading-relaxed text-slate-600 text-justify\">\n                    {activeResult.chemicalExplanation}\n                  </p>\n                </div>\n\n                <div className=\"p-3 bg-blue-50/40 border border-blue-100 rounded-xl\">\n                  <p className=\"font-semibold text-blue-800 text-[11px] mb-1.5 font-mono flex items-center gap-1.5\">\n                    <span className=\"h-1.5 w-1.5 bg-blue-500 rounded-full\"></span>\n                    <span>\345\206\215\345\212\240\345\267\245\345\244\204\347\275\256\344\270\216\346\216\222\344\272\247\346\214\207\344\273\244\345\273\272\350\256\256:</span>\n                  </p>\n                  <p className=\"leading-relaxed font-sans text-slate-700\">\n                    {activeResult.recommendedAction}\n                  </p>\n                </div>\n              </div>\n            ) : (\n              <p className=\"text-xs text-slate-400 text-justify leading-relaxed\">\n                \345\210\206\346\236\220\346\212\245\345\221\212\345\260\206\350\276\223\345\207\272\345\276\256\345\272\224\345\212\233\345\217\230\345\214\226\343\200\201\345\206\267\345\215\264\345\217\212\347\273\223\346\231\266\346\227\266\347\233\270\345\217\230\343\200\201\346\260\247\345\214\226\347\211\251\346\235\202\350\264\250\346\262\211\351\231\215\346\210\226\347\203\255\350\277\236\350\275\247\350\277\207\345\272\246\345\216\213\345\272\224\345\212\233\347\255\211\347\220\206\345\214\226\345\255\246\346\234\272\347\220\206\345\216\237\345\233\240\343\200\202\n              </p>\n            )}\n          </div>\n\n          {/* DETAILED DEFECT LIST / RETICLE POSITION REGIONS */}\n          <div className=\"pt-3 space-y-3 flex-1 flex flex-col\">\n            <div className=\"flex justify-between items-center text-slate-800 border-b border-slate-100 pb-1.5\">\n              <div className=\"flex items-center gap-2\">\n                <FileSpreadsheet className=\"h-4 w-4 text-blue-600\" />\n                <h2 className=\"text-xs font-bold uppercase tracking-wider text-slate-500\">\345\276\256\347\273\206\345\214\272\345\237\237\347\227\205\347\201\266\346\211\253\346\217\217\350\257\246\345\215\225</h2>\n              </div>\n              {activeResult && activeResult.defects && activeResult.defects.length > 0 && (\n                <span className=\"font-mono text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-705 border border-slate-200 font-bold\">\n                  {activeResult.defects.length} \344\270\252\347\233\256\346\240\207\n                </span>\n              )}\n            </div>\n\n            {activeResult && activeResult.defects && activeResult.defects.length > 0 ? (\n              <div className=\"space-y-2 max-h-[220px] overflow-y-auto pr-1\">\n                {activeResult.defects.map((defect) => {\n                  const isHovered = hoveredDefectId === defect.id;\n                  const isSelected = selectedDefectId === defect.id;\n                  \n                  return (\n                    <div\n                      key={defect.id}\n                      id={`defect_card_${defect.id}`}\n                      onMouseEnter={() => setHoveredDefectId(defect.id)}\n                      onMouseLeave={() => setHoveredDefectId(null)}\n                      onClick={() => setSelectedDefectId(isSelected ? null : defect.id)}\n                      className={`p-3 rounded-xl border text-xs cursor-pointer transition-all ${\n                        isSelected || isHovered\n                          ? \'bg-blue-50/70 border-blue-400 shadow-sm\'\n                          : \'bg-slate-50 border-slate-200 hover:bg-slate-100/80 text-slate-800\'\n                      }`}\n                    >\n                      <div className=\"flex justify-between items-start mb-1\">\n                        <div className=\"flex items-center gap-1.5\">\n                          <span className={`h-2 w-2 rounded-full ${\n                            defect.severity === \'High\' ? \'bg-red-500\' :\n                            defect.severity === \'Medium\' ? \'bg-amber-400\' : \'bg-blue-400\'\n                          }`}></span>\n                          <span className=\"font-bold text-slate-800\">{defect.typeName}</span>\n                        </div>\n                        <span className={`px-1.5 py-0.5 rounded-[4px] text-[9px] font-mono font-bold ${\n                          defect.severity === \'High\' \n                            ? \'bg-red-100 text-red-750 border border-red-200\' \n                            : defect.severity === \'Medium\'\n                            ? \'bg-amber-100 text-amber-750 border border-amber-200\'\n                            : \'bg-blue-100 text-blue-750 border border-blue-200\'\n                        }`}>\n                          {defect.severity === \'High\' ? \'\351\253\230\345\215\261\351\231\251\' : defect.severity === \'Medium\' ? \'\344\270\255\347\255\211\' : \'\344\275\216\345\215\261\345\256\263\'}\n                        </span>\n                      </div>\n                      \n                      <p className=\"text-[11px] text-slate-500 leading-relaxed font-sans mt-0.5\">\n                        {defect.description}\n                      </p>\n\n                      <div className=\"flex justify-between items-center text-[10px] text-slate-450 font-mono mt-2 pt-2 border-t border-slate-200/60\">\n                        <span>CCD \345\235\220\346\240\207: [Y:{defect.bbox[0]}, X:{defect.bbox[1]}]</span>\n                        <div className=\"flex items-center gap-2.5\">\n                          <span className=\"text-emerald-600 font-bold\">\347\275\256\344\277\241\345\200\274 {(defect.confidence * 100).toFixed(0)}%</span>\n                          {/* Manual Audit Trigger button */}\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              handleOpenAuditModal(defect);\n                            }}\n                            className=\"text-blue-600 hover:text-blue-700 font-bold underline underline-offset-2\"\n                            title=\"\344\277\256\346\255\243\347\274\272\351\231\267\345\261\236\346\200\247\345\210\206\347\261\273\344\270\216\345\215\261\351\231\251\347\255\211\347\272\247\"\n                          >\n                            \344\270\223\345\256\266\345\244\215\345\256\241\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            ) : activeResult ? (\n              <div className=\"py-6 text-center text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl space-y-1\">\n                <ShieldCheck className=\"h-6 w-6 text-emerald-600 mx-auto mb-1 animate-pulse\" />\n                <p className=\"font-bold\">\346\235\220\350\264\250\346\243\200\351\252\214\345\220\210\346\240\274</p>\n                <p className=\"text-[10px] text-slate-500\">\346\235\277\351\235\242\344\270\212\350\241\250\351\235\242\347\262\276\345\276\256\346\211\253\346\217\217\344\273\252\345\206\205\346\234\252\346\216\242\346\237\245\345\210\260\345\217\257\350\247\201\347\274\272\351\231\267\343\200\202</p>\n              </div>\n            ) : (\n              <p className=\"text-xs text-slate-450 text-center py-6 border border-slate-150 border-dashed rounded-xl\">\n                \350\257\267\345\205\210\345\234\250\345\267\246\344\270\213\350\247\222\345\220\257\345\212\250\350\257\212\346\226\255\343\200\202\n              </p>\n            )}\n          </div>\n        </section>\n      </main>\n\n      {/* METALLURGY EXPERT AUDIT OVERRIDE MODAL - Human in the loop overrides */}\n      {auditingDefect && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm\">\n          <div className=\"bg-white border border-slate-200 rounded-2xl w-full max-w-md p-6 relative shadow-2xl text-slate-80s text-slate-800\">\n            <button\n              onClick={() => setAuditingDefect(null)}\n              className=\"absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-1 rounded-full hover:bg-slate-100\"\n            >\n              <X className=\"h-5 w-5\" />\n            </button>\n\n            <div className=\"flex items-center gap-2 mb-4 text-slate-800\">\n              <Settings className=\"h-5 w-5 text-blue-600\" />\n              <h3 className=\"text-sm font-bold uppercase tracking-wider\">\350\264\250\346\243\200\345\267\245\347\250\213\345\270\210\345\244\215\346\240\270\345\256\241\350\256\241\347\252\227</h3>\n            </div>\n\n            <div className=\"text-xs text-slate-600 mb-4 bg-slate-50 p-3 rounded-lg border border-slate-150 font-mono\">\n              <p>\347\274\272\351\231\267ID: <span className=\"font-bold text-slate-800\">{auditingDefect.id}</span></p>\n              <p className=\"mt-1\">\345\275\223\345\211\215AI\350\257\204\350\257\255: <span className=\"text-slate-500\">{auditingDefect.description}</span></p>\n            </div>\n\n            <div className=\"space-y-4\">\n              {/* Dropdown class taxonomy type selection */}\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-slate-700 block\">\347\274\272\351\231\267\351\207\215\345\275\222\347\261\273\345\210\206\347\261\273 (Type)</label>\n                <select\n                  value={auditClass}\n                  onChange={(e) => setAuditClass(e.target.value)}\n                  className=\"w-full text-xs font-semibold bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:border-blue-500\"\n                >\n                  <option value=\"Scratches\">Scratches (\345\210\222\347\227\225\346\213\211\344\274\244)</option>\n                  <option value=\"Cracks\">Cracks (\350\276\271\347\274\230\346\222\225\350\243\202\350\243\202\347\272\271)</option>\n                  <option value=\"Pitting\">Pitting (\350\266\205\351\205\270\350\232\200\351\233\206\350\201\232\345\207\271\345\235\221)</option>\n                  <option value=\"Inclusions\">Inclusions (\344\277\235\346\212\244\346\270\243\351\222\242\345\206\205\351\235\236\351\207\221\345\261\236\346\235\202\350\264\250)</option>\n                  <option value=\"Scale\">Scale (\345\261\200\351\203\250\347\262\230\347\273\223\347\212\266\346\260\247\345\214\226\351\223\201\351\263\236\347\232\256)</option>\n                  <option value=\"Patches\">Patches (\346\260\264\346\262\271\344\271\263\345\214\226\346\270\205\346\264\227\346\270\215\346\226\221)</option>\n                  <option value=\"None\">None (\346\227\240\347\274\272\351\231\267\357\274\214\351\207\215\345\256\232\344\270\272\345\220\210\346\240\274\346\235\277\351\235\242)</option>\n                </select>\n              </div>\n\n              {/* Severity selection */}\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-slate-700 block\">\345\215\261\345\256\263\344\270\245\351\205\267\345\272\246 (Severity)</label>\n                <div className=\"grid grid-cols-3 gap-2 text-xs\">\n                  {([\'Low\', \'Medium\', \'High\'] as const).map((sev) => (\n                    <button\n                      key={sev}\n                      type=\"button\"\n                      onClick={() => setAuditSeverity(sev)}\n                      className={`py-1.5 px-2 rounded-lg font-bold border transition ${\n                        auditSeverity === sev\n                          ? sev === \'High\' ? \'bg-red-50 border-red-300 text-red-700\' : sev === \'Medium\' ? \'bg-amber-50 border-amber-300 text-amber-700\' : \'bg-blue-50 border-blue-300 text-blue-700\'\n                          : \'bg-white border-slate-200 text-slate-500 hover:text-slate-700\'\n                      }`}\n                    >\n                      {sev === \'High\' ? \'HIGH\345\215\261\351\231\251\' : sev === \'Medium\' ? \'MEDIUM\344\270\255\347\255\211\' : \'LOW\345\276\256\345\274\261\'}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Expert physical commentary */}\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-slate-700 block\">\345\267\245\347\250\213\345\270\210\347\220\206\345\214\226\345\256\241\350\256\241\345\244\207\346\263\250 (\345\277\205\345\241\253)</label>\n                <textarea\n                  rows={3}\n                  value={auditComment}\n                  onChange={(e) => setAuditComment(e.target.value)}\n                  placeholder=\"\350\257\267\350\276\223\345\205\245\344\272\272\345\267\245\345\210\206\346\236\220\345\244\207\346\263\250\343\200\202\344\276\213\345\246\202\357\274\232\350\276\212\347\211\207\345\261\200\351\203\250\347\262\230\347\240\202\345\257\274\350\207\264\346\213\211\344\274\270\346\273\221\347\227\225...\"\n                  className=\"w-full text-xs bg-white border border-slate-205 rounded-lg p-2.5 text-slate-850 focus:outline-none focus:border-blue-500 placeholder-slate-400\"\n                />\n              </div>\n\n              <div className=\"flex gap-2.5 pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setAuditingDefect(null)}\n                  className=\"flex-1 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs text-slate-700 font-semibold border border-slate-200 transition\"\n                >\n                  \345\217\226\346\266\210\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={submitManualAudit}\n                  className=\"flex-1 py-2 px-4 bg-blue-600 hover:bg-blue-750 rounded-lg text-xs text-white font-bold transition flex items-center justify-center gap-1.5 shadow-sm\"\n                >\n                  <Check className=\"h-4 w-4\" />\n                  \346\240\270\346\237\245\347\255\276\345\217\221(Override)\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* HISTORICAL ARCHIVE PORTAL MODAL */}\n      {showHistoryModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm\">\n          <div className=\"bg-white border border-slate-200 rounded-2xl w-full max-w-2xl p-6 relative shadow-2xl flex flex-col max-h-[85vh] text-slate-800\">\n            <button\n              onClick={() => setShowHistoryModal(false)}\n              className=\"absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-1.5 rounded-full hover:bg-slate-100 bg-slate-50 border border-slate-100\"\n            >\n              <X className=\"h-4.5 w-4.5\" />\n            </button>\n\n            <div className=\"flex items-center gap-2.5 mb-5 border-b border-slate-100 pb-3\">\n              <History className=\"h-5 w-5 text-blue-600\" />\n              <div>\n                <h3 className=\"text-sm font-bold uppercase tracking-wider text-slate-800\">\350\275\247\346\235\220\347\274\272\351\231\267\345\205\211\345\255\246\345\216\206\345\217\262\346\216\242\346\237\245\346\227\245\345\277\227</h3>\n                <p className=\"text-[11px] text-slate-405 text-slate-500\">\346\243\200\346\265\213\345\261\245\345\216\206\345\267\262\345\256\211\345\205\250\347\246\273\347\272\277\344\277\235\345\255\230\345\234\250\346\234\254\345\234\260\345\277\253\347\205\247\346\225\260\346\215\256\345\272\223\344\270\255</p>\n              </div>\n            </div>\n\n            <div className=\"flex-1 overflow-y-auto space-y-2.5 pr-1\">\n              {history.length > 0 ? (\n                history.map((rec) => {\n                  const hasDefects = rec.result.defects && rec.result.defects.length > 0;\n                  return (\n                    <div\n                      key={rec.id}\n                      onClick={() => handleRecallHistoryRecord(rec)}\n                      className=\"p-3.5 bg-slate-50 border border-slate-200 hover:border-blue-400 hover:bg-white rounded-xl cursor-pointer transition flex flex-col md:flex-row justify-between items-start md:items-center gap-3 relative group\"\n                    >\n                      <div className=\"space-y-1\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className={`text-[10px] font-mono px-1.5 py-0.5 rounded font-bold ${hasDefects ? \'bg-amber-50 text-amber-700 border border-amber-200\' : \'bg-emerald-50 text-emerald-705 border border-emerald-200\'}`}>\n                            {rec.result.overallStatus === \'Pass\' ? \'\345\220\210\346\240\274\' : rec.result.overallStatus === \'Marginal\' ? \'\351\231\215\347\272\247\' : \'\344\270\215\345\220\210\346\240\274\'}\n                          </span>\n                          <h4 className=\"text-xs font-bold text-slate-800 tracking-wide\">{rec.imageName}</h4>\n                        </div>\n                        \n                        <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-slate-500 font-mono\">\n                          <span>\346\265\201\346\260\264\345\217\267: {rec.id}</span>\n                          <span>\346\227\266\351\227\264: {rec.timestamp}</span>\n                          {hasDefects && (\n                            <span className=\"text-amber-600 font-bold\">\346\243\200\346\265\213\347\274\272\351\231\267 {rec.result.defects.length} \345\244\204</span>\n                          )}\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center gap-3 shrink-0 self-end md:self-center\">\n                        <span className=\"text-xs text-slate-650 font-mono font-bold bg-white px-2.5 py-1 rounded border border-slate-200\">\n                          \346\214\207\346\225\260: {rec.result.severityIndex}\n                        </span>\n                        \n                        <button\n                          onClick={(e) => handleDeleteHistoryItem(rec.id, e)}\n                          className=\"p-1.5 bg-red-50 hover:bg-red-1050 hover:bg-red-100 rounded border border-red-200 text-slate-505 hover:text-red-600 transition\"\n                          title=\"\345\210\240\351\231\244\346\255\244\345\255\230\346\241\243\"\n                        >\n                          <Trash2 className=\"h-4 w-4\" />\n                        </button>\n                      </div>\n                    </div>\n                  );\n                })\n              ) : (\n                <div className=\"py-12 text-center text-xs text-slate-400\">\n                  <Database className=\"h-8 w-8 text-slate-300 mx-auto mb-2\" />\n                  <span>\346\232\202\346\227\240\345\216\206\345\217\262\350\257\212\346\226\255\346\227\245\345\277\227\345\255\230\346\241\243</span>\n                </div>\n              )}\n            </div>\n\n            <div className=\"pt-4 border-t border-slate-100 mt-4 flex justify-end\">\n              <button\n                onClick={() => setShowHistoryModal(false)}\n                className=\"py-1.5 px-4 bg-slate-800 hover:bg-slate-700 text-white rounded text-xs font-semibold transition\"\n              >\n                \345\205\263\351\227\255\350\247\206\347\252\227\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* FOOTER METADATA telemetries */}\n      <footer className=\"bg-white border-t border-slate-205 py-3 px-6 flex justify-between items-center text-[10px] text-slate-450 font-mono mt-auto select-none shrink-0 shadow-inner\">\n        <span>\302\251 SteelEye Surface Terminal \342\200\242 V4.2.0-Pro</span>\n        <span>CCD: Active \342\200\242 Laser: {laserSpeed}00Hz \342\200\242 Contrast: {contrastThreshold}%</span>\n      </footer>"
    }
