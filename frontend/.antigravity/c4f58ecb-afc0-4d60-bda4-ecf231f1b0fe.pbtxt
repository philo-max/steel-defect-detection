          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              {!isScanning && activeResult && activeResult.defects && activeResult.defects.map((defect) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const isSelected = selectedDefectId === defect.id;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const isHovered = hoveredDefectId === defect.id;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // Color mapping logic depending on severity levels"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const colorTheme = "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  defect.severity === \'High\' "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    ? { border: \'border-red-500\', bg: \'bg-red-500/15\', text: \'text-red-400\', labelBg: \'bg-red-950 text-red-300 border-red-500\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    : defect.severity === \'Medium\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    ? { border: \'border-amber-500\', bg: \'bg-amber-500/10\', text: \'text-amber-400\', labelBg: \'bg-amber-950 text-amber-300 border-amber-500\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    : { border: \'border-blue-500\', bg: \'bg-blue-500/10\', text: \'text-blue-400\', labelBg: \'bg-blue-950 text-blue-300 border-blue-500\' };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                return ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
