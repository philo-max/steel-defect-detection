        }
        lines {
          text: "    type: \'Scale\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    description: \'\351\253\230\346\270\251\351\253\230\345\216\213\344\270\213\357\274\214\346\235\277\346\235\220\350\241\250\351\235\242\344\277\235\346\212\244\346\260\224\344\270\215\350\266\263\346\210\226\347\262\227\350\275\247\351\231\244\351\263\236\344\270\215\345\207\200\357\274\214\345\206\267\345\215\264\346\227\266\344\272\247\347\224\237\346\232\227\351\273\221\350\211\262\346\260\247\345\214\226\351\223\201\357\274\210Fe3O4\357\274\211\347\211\207\347\212\266\351\263\236\345\261\202\343\200\202\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    renderType: \'scale\',"
